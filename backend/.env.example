# ─────────────────────────────────────────────────────────────────
# SETU-Care Backend Environment Variables — EXAMPLE FILE
# Copy to .env and fill in real values. NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────

# ── AWS Configuration ─────────────────────────────────────────────
# Use IAM Role attached to App Runner in production (no keys needed)
# These are only for local development
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY_HERE

# ── Amazon Bedrock ────────────────────────────────────────────────
# Default: Claude 3 Haiku (fast, cost-effective)
# Options: anthropic.claude-3-haiku-20240307-v1:0
#          anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ── Amazon DynamoDB ───────────────────────────────────────────────
DYNAMODB_TABLE_NAME=setu-care-patients

# ── Amazon S3 ────────────────────────────────────────────────────
S3_BUCKET_NAME=setu-care-documents-YOUR_ACCOUNT_ID

# ── CORS / Security ──────────────────────────────────────────────
# In production: https://your-app.amplifyapp.com
FRONTEND_ORIGIN=http://localhost:3000

# ── Mock Mode ────────────────────────────────────────────────────
# Set to true for local development without real AWS credentials
# All AWS calls return realistic synthetic data
MOCK_MODE=true

# ── App Config ───────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=5
